# Demo Environment - King Of Tacos
# Usage: docker compose -f docker-compose.demo.yml up -d

# Database (MySQL conteneurisé)
DATABASE_URL=mysql://demo:demodemo123@mysql:3306/king_of_tacos_demo?schema=king_of_tacos_demo

# JWT Secret (demo - changer en prod !)
JWT_SECRET=king-of-tacos-demo-super-secret-key-2024-change-me-in-production-very-long-and-secure

# Server
PORT=5000
NODE_ENV=demo

# CORS (localhost + demo ports)
CORS_ORIGIN=http://localhost:3001,http://localhost:80,http://localhost:3000

# Stripe Test (sandbox)
STRIPE_SECRET_KEY=sk_test_51...  # Ajouter votre clé test Stripe
STRIPE_PUBLISHABLE_KEY=pk_test_51...  # Clé publique test

# Frontend API URL (dans FE build args)
REACT_APP_API_URL=http://localhost:5001/api
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Ngrok Auth Token (optionnel pour tunnel public)
NGROK_AUTHTOKEN=your_ngrok_token_here  # https://ngrok.com/get-started/your-authtoken

# Demo Admin Login
# Email: admin@test.com
# Password: password123
