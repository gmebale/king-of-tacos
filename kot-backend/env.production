NODE_ENV=production
PORT=5000
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public
SESSION_SECRET=change-me
JWT_SECRET=change-me
FRONTEND_URL=https://your-domain.com

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://your-domain.com/api/auth/google/callback

# Apple Sign-In
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOURKEY\n-----END PRIVATE KEY-----"

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# PayPal
PAYPAL_API_BASE=https://api-m.paypal.com
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret


# MyPVIT sandbox first; never commit real credentials
PVIT_ENABLED=false
PVIT_MODE=test
PVIT_API_BASE=https://api.mypvit.pro
PVIT_OPERATION_ACCOUNT_CODE=
PVIT_SECRET_API_CODE=
PVIT_SECRET_PASSWORD=
PVIT_PAYMENT_API_CODE=
PVIT_CALLBACK_URL_CODE=
PVIT_STATUS_API_CODE=
PVIT_KYC_API_CODE=
PVIT_SUPPORTED_OPERATORS=AIRTEL_MONEY,MOOV_MONEY
PVIT_STATUS_FALLBACK_DELAY_MS=180000
