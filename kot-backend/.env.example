# Database
DATABASE_URL="postgresql://username:password@localhost:5432/kot_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Google Places API (homepage reviews). Keep the API key server-side.
GOOGLE_PLACES_API_KEY=""
GOOGLE_PLACE_ID=""
# Optional direct Google review link copied from the Business Profile.
GOOGLE_REVIEW_URL=""

# Frontend URL
FRONTEND_URL="http://localhost:3000"

# Server
PORT=5000
NODE_ENV="development"
