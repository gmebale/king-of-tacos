// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

enum Role {
  client
  staff
  admin
}

enum OrderStatus {
  en_attente
  en_preparation
  prete
  en_livraison
  livree
  annulee
}

enum Category {
  tacos
  boissons
  accompagnements
  desserts
}

model User {
  id             Int      @id @default(autoincrement())
  email          String   @unique
  password       String?
  google_id      String?  @unique
  full_name      String
  phone          String?
  role           Role     @default(client)
  loyalty_points Int      @default(0)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  orders         Order[]

  @@map("users")
}

model Product {
  id                   Int         @id @default(autoincrement())
  name                 String
  description          String?
  price                Int         // Prix en centimes
  discount_percentage  Int         @default(0)
  category             Category
  available            Boolean     @default(true)
  image                String?
  stock                Int         @default(0)  // Quantité en stock
  stock_alert_threshold Int        @default(10) // Seuil d'alerte stock
  created_at           DateTime    @default(now())
  updated_at           DateTime    @updatedAt

  @@map("products")
}

model Order {
  id                String      @id @default(cuid())
  user_id           Int?
  user              User?       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  total_amount      Int         // Montant total en centimes
  status            OrderStatus @default(en_attente)
  created_date      DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  // Order details
  customer_name     String?
  customer_phone    String?
  customer_email    String?
  order_type        String?     // emporter, sur_place, livraison
  delivery_address  String?
  pickup_time       String?
  notes             String?

  items             OrderItem[]

  @@map("orders")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  order_id      String
  order         Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_name  String
  quantity      Int

  @@map("order_items")
}

enum RewardType {
  free_delivery
  gifted_product
  discount
  custom
}

model LoyaltyReward {
  id              String      @id @default(cuid())
  name            String
  description     String?
  type            RewardType
  points_required Int
  is_active       Boolean     @default(true)
  created_at      DateTime    @default(now())
  updated_at      DateTime    @updatedAt

  redemptions     LoyaltyRedemption[]

  @@map("loyalty_rewards")
}

model LoyaltyRedemption {
  id          String      @id @default(cuid())
  user_id     Int
  user        User        @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reward_id   String
  reward      LoyaltyReward @relation(fields: [reward_id], references: [id], onDelete: Cascade)
  points_used Int
  created_at  DateTime    @default(now())

  @@map("loyalty_redemptions")
}

enum PromoType {
  percentage
  fixed_amount
  free_delivery
}

model PromoCode {
  id              String    @id @default(cuid())
  code            String    @unique
  description     String?
  type            PromoType
  value           Int       // Pourcentage ou montant fixe en centimes
  min_order_amount Int?     // Montant minimum de commande en centimes
  max_uses        Int?      // Nombre maximum d'utilisations
  used_count      Int       @default(0)
  is_active       Boolean   @default(true)
  expires_at      DateTime?
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@map("promo_codes")
}
