// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  label       String
  module      String
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@map("permissions")
}

model RolePermission {
  id            Int        @id @default(autoincrement())
  role_id       Int
  permission_id Int
  granted       Boolean    @default(true)

  role       Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([role_id, permission_id])
  @@map("role_permissions")
}

model UserPermission {
  id            Int        @id @default(autoincrement())
  user_id       Int
  permission_id Int
  granted       Boolean    @default(true)

  user       User       @relation(fields: [user_id], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@unique([user_id, permission_id])
  @@map("user_permissions")
}

enum OrderStatus {
  en_attente
  en_preparation
  prete
  en_livraison
  servie
  recuperee
  livree
  annulee
  cloturee
}

enum PaymentMethod {
  cash
  card
  mobile_money
  loyalty_points
  paypal
  stripe
}

enum PaymentStatus {
  pending
  requires_action
  paid
  failed
  refunded
}

enum PreparationStation {
  cuisine_chaude
  cuisine_froide
  bar
}

enum PreparationStatus {
  en_attente
  en_preparation
  prete
}

enum Category {
  tacos
  burritos
  burger
  boissons
  accompagnements
  desserts
  options // Ajouté pour les options de customisation
}

model CategoryModel {
  id                   Int                @id @default(autoincrement())
  name                 String             @unique
  displayName          String
  preparation_station  PreparationStation @default(cuisine_chaude)
  is_menu_visible      Boolean            @default(true)
  display_order        Int                @default(0)
  products             Product[]

  @@map("categories")
}

model User {
  id             Int     @id @default(autoincrement())
  email          String  @unique
  password       String?
  google_id      String? @unique
  apple_id       String? @unique
  full_name      String
  phone          String?
  role           String  @default("client")
  role_id        Int?
  roleRef        Role?   @relation(fields: [role_id], references: [id], onDelete: SetNull)
  loyalty_points Int     @default(0)
  is_active      Boolean @default(true)
  pagePermissions Json?
  server_pin_hash String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  orders             Order[]
  validatedOrders    Order[] @relation("orderValidatedBy")
  closedOrders       Order[] @relation("orderClosedBy")
  loyaltyRedemptions LoyaltyRedemption[]
  loyaltyPointEntries LoyaltyPointEntry[] @relation("loyaltyPointOwner")
  loyaltyPointActions LoyaltyPointEntry[] @relation("loyaltyPointActor")
  orderCancellations OrderCancellation[] @relation("orderCancellationActor")
  promoCodes PromoCode[]
  reviews            Review[]
  logs               Log[]
  userPermissions    UserPermission[]
  createdExpenses   Expense[]
  createdCashExpenses CashExpense[]
  expenseCatalogItems ExpenseCatalogItem[]

  @@map("users")
}

model Product {
  id                    Int            @id @default(autoincrement())
  name                  String
  description           String?
  price                 Int // Prix entier en FCFA
  discount_percentage   Int            @default(0)
  categoryId            Int
  category              CategoryModel? @relation(fields: [categoryId], references: [id])
  available             Boolean        @default(true)
  image                 String?
  stock                 Int            @default(0) // Quantité en stock
  stock_alert_threshold Int            @default(10) // Seuil d'alerte stock
  average_purchase_cost Int?
  loyalty_points        Int            @default(0)
  type                  String? // Type du produit (main, size, meat, sauce, extra, side)
  customization         Json? // Configuration des options de personnalisation
  created_at            DateTime       @default(now())
  updated_at            DateTime       @updatedAt

  // Relations pour options
  optionFor ProductOption[] @relation("optionProducts")
  options   ProductOption[] @relation("productOptions")
  taxRates ProductTax[]
  orderItems OrderItem[]
  expenseItems ExpenseItem[]
  cashExpenseItems CashExpenseItem[]
  giftedRewards LoyaltyReward[] @relation("giftedRewardProduct")

  @@map("products")
}

model Order {
  id                  String         @id @default(cuid())
  order_code          String?        @unique
  user_id             Int?
  user                User?          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  total_amount        Int // Montant total entier en FCFA
  status              OrderStatus    @default(en_attente)
  payment_method      PaymentMethod?
  payment_status      PaymentStatus  @default(pending)
  payment_provider_id String?
  payment_receipt_url String?
  created_date        DateTime       @default(now())
  updated_at          DateTime       @updatedAt

  // Order details
  customer_name    String?
  customer_phone   String?
  customer_email   String?
  order_type       String? // emporter, sur_place, livraison
  service_location String?
  table_number     String?
  delivery_address String?
  pickup_time      String?
  notes            String?
  promo_code_id    String?
  discount_amount  Int @default(0)
  promoCode        PromoCode? @relation(fields: [promo_code_id], references: [id], onDelete: SetNull)
  loyalty_redemption_id String? @unique
  loyaltyRedemption LoyaltyRedemption? @relation(fields: [loyalty_redemption_id], references: [id], onDelete: SetNull)

  validated_by Int?
  validatedBy  User?  @relation("orderValidatedBy", fields: [validated_by], references: [id])
  validated_at DateTime?

  closed_by Int?
  closedBy  User?  @relation("orderClosedBy", fields: [closed_by], references: [id])
  cash_register_session_id Int?
  cashRegisterSession CashRegisterSession? @relation("orderCashSession", fields: [cash_register_session_id], references: [id])
  closed_at DateTime?

  items   OrderItem[]
  reviews Review[]
  loyaltyPointEntries LoyaltyPointEntry[]
  cancellation OrderCancellation?

  @@index([cash_register_session_id])
  @@index([promo_code_id])

  @@map("orders")
}

model OrderCancellationReason {
  id             Int                 @id @default(autoincrement())
  code           String              @unique @db.VarChar(64)
  label          String              @db.VarChar(191)
  is_active      Boolean             @default(true)
  display_order  Int                 @default(0)
  created_at     DateTime            @default(now())
  updated_at     DateTime            @updatedAt
  cancellations OrderCancellation[]

  @@map("order_cancellation_reasons")
}

model OrderCancellation {
  id                   Int                     @id @default(autoincrement())
  order_id             String                  @unique
  order                Order                   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  reason_id            Int?
  reason               OrderCancellationReason? @relation(fields: [reason_id], references: [id], onDelete: SetNull)
  reason_text          String?                 @db.VarChar(500)
  cancelled_by_user_id Int?
  cancelledBy          User?                   @relation("orderCancellationActor", fields: [cancelled_by_user_id], references: [id], onDelete: SetNull)
  actor_role           String                  @db.VarChar(64)
  cancelled_at         DateTime                @default(now())

  @@index([reason_id, cancelled_at])
  @@index([cancelled_by_user_id, cancelled_at])
  @@map("order_cancellations")
}

model OrderCodeSequence {
  id         Int      @id @default(autoincrement())
  date       String   @unique
  counter    Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("order_code_sequences")
}

model OrderItem {
  id                   Int     @id @default(autoincrement())
  order_id             String
  order                Order   @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_name         String
  quantity             Int
  price                Int // Prix unitaire entier en FCFA
  customization        Json? // Détails de personnalisation du produit
  inventory_components Json? // Snapshot des produits choisis à débiter du stock
  customizationSummary String? // Résumé textuel des personnalisations
  preparation_station PreparationStation?
  preparation_status PreparationStatus @default(en_attente)
  product_id Int?
  product Product? @relation(fields: [product_id], references: [id], onDelete: SetNull)
  unit_tax_base Int @default(0)
  unit_tax_total Int @default(0)
  tax_breakdown Json?
  unit_cost_snapshot Int?
  stock_deducted Boolean @default(false)
  unit_loyalty_points Int @default(0)
  free_quantity Int @default(0)

  @@map("order_items")
}

enum RewardType {
  free_delivery
  gifted_product
  discount
  custom
}

enum LoyaltyRedemptionStatus {
  claimed
  used
  expired
}

enum LoyaltyPointEntryType {
  earned
  manual_adjustment
  redemption
  refund_reversal
}

model LoyaltyReward {
  id              String     @id @default(cuid())
  name            String
  description     String?
  type            RewardType
  points_required Int
  is_active       Boolean    @default(true)
  quantity_limit  Int?
  quantity_claimed Int @default(0)
  expires_at      DateTime?
  discount_percent Int?
  gifted_product_id Int?
  giftedProduct Product? @relation("giftedRewardProduct", fields: [gifted_product_id], references: [id], onDelete: SetNull)
  tier_level Int?
  tier LoyaltyTier? @relation(fields: [tier_level], references: [level], onDelete: SetNull)
  created_at      DateTime   @default(now())
  updated_at      DateTime   @updatedAt

  redemptions LoyaltyRedemption[]

  @@index([gifted_product_id])
  @@index([tier_level])

  @@map("loyalty_rewards")
}

model LoyaltyTier {
  id Int @id @default(autoincrement())
  level Int @unique
  title String
  icon String
  threshold_points Int?
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  rewards LoyaltyReward[]

  @@map("loyalty_tiers")
}

model LoyaltyRedemption {
  id          String        @id @default(cuid())
  user_id     Int
  user        User          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  reward_id   String
  reward      LoyaltyReward @relation(fields: [reward_id], references: [id], onDelete: Cascade)
  points_used Int
  status LoyaltyRedemptionStatus @default(claimed)
  expires_at DateTime?
  promo_code_id String? @unique
  promoCode PromoCode? @relation("redemptionPromo", fields: [promo_code_id], references: [id], onDelete: SetNull)
  appliedOrder Order?
  created_at  DateTime      @default(now())

  @@map("loyalty_redemptions")
}

enum PromoType {
  percentage
  fixed_amount
  free_delivery
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String?
  type             PromoType
  value            Int // Pourcentage ou montant fixe entier en FCFA
  min_order_amount Int? // Montant minimum de commande entier en FCFA
  max_uses         Int? // Nombre maximum d'utilisations
  used_count       Int       @default(0)
  is_active        Boolean   @default(true)
  expires_at       DateTime?
  user_id          Int?
  user             User? @relation(fields: [user_id], references: [id], onDelete: Cascade)
  redemption       LoyaltyRedemption? @relation("redemptionPromo")
  orders           Order[]
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  @@index([user_id])

  @@map("promo_codes")
}

model LoyaltyPointEntry {
  id Int @id @default(autoincrement())
  user_id Int
  user User @relation("loyaltyPointOwner", fields: [user_id], references: [id], onDelete: Cascade)
  actor_id Int?
  actor User? @relation("loyaltyPointActor", fields: [actor_id], references: [id], onDelete: SetNull)
  order_id String?
  order Order? @relation(fields: [order_id], references: [id], onDelete: SetNull)
  type LoyaltyPointEntryType
  points Int
  reason String?
  created_at DateTime @default(now())

  @@unique([order_id, type])
  @@index([user_id, created_at])
  @@map("loyalty_point_entries")
}

enum ReviewStatus {
  pending
  published
  hidden
}

model Review {
  id         String       @id @default(cuid())
  order_id   String
  order      Order        @relation(fields: [order_id], references: [id], onDelete: Cascade)
  user_id    Int
  user       User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  rating     Int
  comment    String
  status     ReviewStatus @default(pending)
  created_at DateTime     @default(now())
  updated_at DateTime     @updatedAt

  @@map("reviews")
}

model CashRegisterSession {
  id               Int       @id @default(autoincrement())
  opened_at        DateTime  @default(now())
  closed_at        DateTime?
  opening_balance  Int // Solde d'ouverture entier en FCFA
  closing_balance  Int? // Solde de clôture entier en FCFA
  current_balance  Int // Solde actuel entier en FCFA
  total_revenue    Int? // Revenus entiers en FCFA
  cash_payments    Int? // Paiements en espèces entiers en FCFA
  card_payments    Int? // Paiements par carte entiers en FCFA
  mobile_payments  Int? // Paiements mobile money entiers en FCFA
  loyalty_payments Int? // Paiements points fidélité entiers en FCFA
  notes            String?
  cash_expenses    Int       @default(0)
  orders           Order[]   @relation("orderCashSession")
  expenses         CashExpense[]

  @@map("cash_register_sessions")
}

model ExpenseCatalogItem {
  id Int @id @default(autoincrement())
  category String
  description String
  expense_type String @default("operating")
  active Boolean @default(true)
  created_by Int?
  createdBy User? @relation(fields: [created_by], references: [id], onDelete: SetNull)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  cashExpenses CashExpense[]

  @@index([created_by])
  @@map("expense_catalog_items")
}

model CashExpense {
  id Int @id @default(autoincrement())
  session_id Int
  session CashRegisterSession @relation(fields: [session_id], references: [id])
  catalog_item_id Int?
  catalogItem ExpenseCatalogItem? @relation(fields: [catalog_item_id], references: [id], onDelete: SetNull)
  category String
  description String
  expense_type String @default("operating")
  amount Int
  payment_method String
  supplier String?
  created_by Int?
  createdBy User? @relation(fields: [created_by], references: [id], onDelete: SetNull)
  expense_date DateTime @default(now())
  created_at DateTime @default(now())
  items CashExpenseItem[]

  @@index([session_id, expense_date])
  @@index([catalog_item_id])
  @@index([created_by])
  @@map("cash_expenses")
}

model CashExpenseItem {
  id Int @id @default(autoincrement())
  expense_id Int
  expense CashExpense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  product_id Int
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity Int
  unit_cost Int

  @@index([product_id])
  @@index([expense_id])
  @@map("cash_expense_items")
}

model ProductOption {
  id              Int     @id @default(autoincrement())
  productId       Int
  product         Product @relation("productOptions", fields: [productId], references: [id], onDelete: Cascade)
  optionProductId Int
  optionProduct   Product @relation("optionProducts", fields: [optionProductId], references: [id], onDelete: Cascade)
  required        Boolean @default(false)
  maxQuantity     Int?
  optionType      String // e.g. "size", "meat", "sauce", "extra", "side"

  @@map("product_options")
}

model Log {
  id        Int      @id @default(autoincrement())
  user_id   Int
  user      User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role      String   @default("client")
  action    String
  details   String?
  created_at DateTime @default(now())

  @@map("logs")
}

model Settings {
  id    Int    @id @default(autoincrement())
  key   String @unique
  value String

  @@map("settings")
}

model TaxRate {
  id Int @id @default(autoincrement())
  name String @unique
  percentage_basis_points Int
  active Boolean @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  products ProductTax[]

  @@map("tax_rates")
}

model ProductTax {
  product_id Int
  tax_rate_id Int
  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  taxRate TaxRate @relation(fields: [tax_rate_id], references: [id], onDelete: Cascade)

  @@id([product_id, tax_rate_id])
  @@map("product_taxes")
}

model Expense {
  id Int @id @default(autoincrement())
  expense_type String @default("operating")
  category String
  description String
  amount Int
  expense_date DateTime @default(now())
  payment_method String?
  supplier String?
  created_by Int?
  createdBy User? @relation(fields: [created_by], references: [id], onDelete: SetNull)
  items ExpenseItem[]
  created_at DateTime @default(now())

  @@map("expenses")
}

model ExpenseItem {
  id Int @id @default(autoincrement())
  expense_id Int
  expense Expense @relation(fields: [expense_id], references: [id], onDelete: Cascade)
  product_id Int
  product Product @relation(fields: [product_id], references: [id], onDelete: Restrict)
  quantity Int
  unit_cost Int

  @@map("expense_items")
}

model RestaurantLocation {
  id         Int      @id @default(autoincrement())
  slug       String   @unique
  name       String
  active     Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("restaurant_locations")
}

model ProductCustomizationRule {
  id            Int    @id @default(autoincrement())
  productId     Int // Produit principal (ex: tacos, burrito)
  sizeOptionId  Int? // Option de taille (ex: Solo) - NULL si règle générale
  optionType    String // 'meat', 'sauce', 'extra', 'goût'
  maxQuantity   Int
  includedCount Int    @default(0) // Nombre inclus gratuit (ex: 2 sauces)
  extraPrice    Int    @default(0) // Prix supplémentaire par unité

  @@map("product_customization_rules")
}
